{
  "name": "Building a Core",
  "icon": "draconicevolution:draconium_block",
  "category": "draconicevolution:energy_core",
  "sortnum": 1,
  "pages": [
    {
      "type": "patchouli:text",
      "text": "$(li)Place the $(item)Energy Core$() and right-click it.$(li)Use $(l)Tier Up / Tier Down$() to pick a tier.$(li)Press $(l)Toggle Build Guide$() to see a hologram of every block you need.$(li)Place the blocks, or press $(l)Assemble Core$() to let the core place them from your inventory.$(li)Turn the build guide off, add $(l:energy_core/stabilizers)Stabilizers$(/l), then press $(l)Activate$()."
    },
    {
      "type": "patchouli:text",
      "title": "Blocks per tier",
      "text": "$(li)Tier 1: just the core$(li)Tier 2: 6 Draconium$(li)Tier 3: 26 Draconium$(li)Tier 4: 54 Draconium, 26 Redstone$(li)Tier 5: 90 Draconium, 80 Redstone$(li)Tier 6: 150 Draconium, 178 Redstone$(li)Tier 7: 210 Draconium, 328 Redstone$(li)Tier 8: 786 Draconium, 378 Awakened Draconium"
    },
    {
      "type": "patchouli:text",
      "text": "All of these are storage blocks; any Draconium or Redstone block tagged as such works."
    },
